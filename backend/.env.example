# HealthEase AI - Environment Configuration

# Application
PROJECT_NAME="HealthEase AI"
VERSION="1.0.0"

# Database (Default uses local SQLite; set PostgreSQL/Supabase URL in production)
DATABASE_URL="sqlite:///./backend/data/healthease.db"

# Optional GenAI Provider Keys (Intelligent built-in medical reasoning engine operates seamlessly if unset)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Security
SECRET_KEY="healthease_ai_secure_production_secret_key_change_in_prod"
UPLOAD_DIR="./backend/uploads"
